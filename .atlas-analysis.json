  "keyFeatures": [
    "Plugin-based architecture for extensibility",
    "Account creation and management with multiple key types",
    "Fungible and non-fungible token operations",
    "Smart contract compilation, deployment, and verification",
    "Multi-network support (mainnet, testnet, previewnet, localnet)",
    "Encrypted key storage with AES-256-GCM",
    "Topic-based messaging and consensus",
    "Interactive and script modes for automation",
    "JSON and human-readable output formats",
    "Mirror node integration for network queries"
  ],
  "publicApiSurface": [
    "hcli account create",
    "hcli account balance",
    "hcli account list",
    "hcli account import",
    "hcli account delete",
    "hcli token create-ft",
    "hcli token create-nft",
