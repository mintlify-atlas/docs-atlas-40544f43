    "hcli contract-erc20 name",
    "hcli contract-erc20 balance",
    "hcli contract-erc20 transfer",
    "hcli contract-erc721 transfer",
    "hcli topic create",
    "hcli topic submit-message",
    "hcli config set",
    "hcli config get",
    "hcli plugin-management add",
    "hcli plugin-management remove"
